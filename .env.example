# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Active environment. Loads .env first, then .env.{APP_ENV} on top. Required —
# the app fails to boot if this is unset.
APP_ENV=local

# Base URL the dev server binds to (host + port). `artisan serve` reads this.
APP_URL=http://127.0.0.1:7654

# Auto-reload the server when files change. Default: true
# APP_RELOAD=true

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Default log channel: stack | daily | terminal. Default: stack
# LOG_CHANNEL=stack

# Daily rotating file channel. Defaults: debug, storage/logs
# LOG_DAILY_LEVEL=debug
# LOG_DAILY_PATH=storage/logs

# Terminal channel. Default: info
# LOG_TERMINAL_LEVEL=info
